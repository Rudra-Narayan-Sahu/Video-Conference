# AuraMeet Video Conference - Backend Production Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/video-conference

# JWT Authentication Security (MUST BE SET TO A STRONG RANDOM SECRET IN PRODUCTION)
JWT_SECRET=replace_with_a_secure_random_64_char_secret_string
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (Comma-separated list of trusted origins)
ALLOWED_ORIGINS=https://meet.yourdomain.com,https://app.yourdomain.com

# Redis Clustering & Socket.IO Scaling (Optional for standalone, required for multi-node)
REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
MEETING_RATE_LIMIT_WINDOW_MS=300000
MEETING_RATE_LIMIT_MAX=60
